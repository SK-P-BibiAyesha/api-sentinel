openapi: 3.0.3
info:
  title: Contact Details API
  version: "1.0.0"

paths:
  /api/v1/contacts/{id}:
    get:
      summary: Get contact details
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: integer
      responses:
        "200":
          description: Contact details
          content:
            application/json:
              schema:
                type: object
                required:
                  - id
                  - name
                  - email
                properties:
                  id:
                    type: integer
                    example: 101
                  name:
                    type: string
                    example: "Rahul Kumar"
                  email:
                    type: string
                    format: email
                    example: "rahul@example.com"
                  phone:
                    type: string
                    example: "+91-9000000001"
                  age:
                    type: integer
                    example: 24
                  address:
                    type: string
                    example: "Guntur, Andhra Pradesh"
        "404":
          description: Contact not found